{
  "info": {
    "name": "Ticketing - payment-service (Sesión 3)",
    "description": "Peticiones de prueba para payment-service. Pagos simulados. La carpeta SIMULACIÓN cambia en caliente cuán lento o inestable es el servicio. Cada petición incluye pruebas del código HTTP esperado (pestaña Scripts > Post-response).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8083/api/v1",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Pagos",
      "item": [
        {
          "name": "Crear pago -> 201 APPROVED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('APPROVED'); });",
                  "pm.collectionVariables.set('paymentId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 100,\n  \"customerEmail\": \"ana@mail.com\",\n  \"amount\": 900.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear pago que supera el límite (2000) -> 201 REJECTED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('REJECTED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 101,\n  \"customerEmail\": \"ana@mail.com\",\n  \"amount\": 4500.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear pago inválido -> 400 con lista de errores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().errors).to.have.lengthOf(3); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 0,\n  \"customerEmail\": \"x\",\n  \"amount\": -5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Obtener pago por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/payments/{{paymentId}}"
          }
        },
        {
          "name": "Pagos de una reserva",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json()).to.have.lengthOf(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/payments?bookingId=100"
          }
        },
        {
          "name": "Pago inexistente -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/payments/999999"
          }
        }
      ]
    },
    {
      "name": "Simulación",
      "item": [
        {
          "name": "Ver la simulación actual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/simulation"
          }
        },
        {
          "name": "Fallar siempre (failureRate 1.0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{host}}/simulation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 1.0,\n  \"delay\": \"PT0S\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear pago con la simulación activa -> 503",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 503', () => pm.response.to.have.status(503));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/payments",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 102,\n  \"customerEmail\": \"ana@mail.com\",\n  \"amount\": 100.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Responder lento (5 s por pago)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{host}}/simulation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 0.0,\n  \"delay\": \"PT5S\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Volver a la normalidad",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().failureRate).to.eql(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{host}}/simulation",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failureRate\": 0.0,\n  \"delay\": \"PT0S\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}