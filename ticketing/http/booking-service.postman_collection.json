{
  "info": {
    "name": "Ticketing - booking-service (Sesión 3)",
    "description": "Peticiones de prueba para booking-service. Requiere event-service (8081) y payment-service (8083) en marcha. Ejecuta las peticiones en orden; Postman guarda automáticamente los ids de las reservas creadas. Cada petición incluye pruebas del código HTTP esperado (pestaña Scripts > Post-response).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8082/api/v1",
      "type": "string"
    },
    {
      "key": "actuator",
      "value": "http://localhost:8082/actuator",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bigBookingId",
      "value": "2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Reservas",
      "item": [
        {
          "name": "Crear reserva -> 201 (el precio lo da event-service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('PENDING'); });",
                  "pm.test('Validación 2', () => { pm.expect(pm.response.json().unitPrice).to.eql(450); });",
                  "pm.test('Validación 3', () => { pm.expect(pm.response.json().totalAmount).to.eql(900); });",
                  "pm.collectionVariables.set('bookingId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketCategoryId\": 1,\n  \"customerEmail\": \"ana@mail.com\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear reserva inválida -> 400 con lista de errores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().errors).to.have.lengthOf(2); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketCategoryId\": 1,\n  \"customerEmail\": \"no-es-un-correo\",\n  \"quantity\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Zona que no pertenece al evento -> 400 (event-service respondió 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketCategoryId\": 4,\n  \"customerEmail\": \"ana@mail.com\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Obtener reserva por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Listar reservas de un cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/bookings?customerEmail=ana@mail.com"
          }
        },
        {
          "name": "Reserva inexistente -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/bookings/999999"
          }
        }
      ]
    },
    {
      "name": "Pagos",
      "item": [
        {
          "name": "Pagar reserva -> 200 (payment-service aprueba y se emiten los tickets)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });",
                  "pm.test('Validación 2', () => { pm.expect(pm.response.json().paymentId).to.be.a('number'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings/{{bookingId}}/pay"
          }
        },
        {
          "name": "Tickets emitidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json()).to.have.lengthOf(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/bookings/{{bookingId}}/tickets"
          }
        },
        {
          "name": "Pagar otra vez -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings/{{bookingId}}/pay"
          }
        },
        {
          "name": "Cancelar una reserva confirmada -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{host}}/bookings/{{bookingId}}/cancel"
          }
        },
        {
          "name": "Crear reserva de 10 entradas VIP (S/ 4500) -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bigBookingId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketCategoryId\": 1,\n  \"customerEmail\": \"luis@mail.com\",\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Pagar la reserva de S/ 4500 -> 402 (supera el límite de la tarjeta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 402', () => pm.response.to.have.status(402));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().title).to.eql('Pago rechazado'); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings/{{bigBookingId}}/pay"
          }
        },
        {
          "name": "La reserva rechazada sigue PENDING",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('PENDING'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/bookings/{{bigBookingId}}"
          }
        }
      ]
    },
    {
      "name": "Resiliencia (actuator)",
      "item": [
        {
          "name": "Estado de los Circuit Breakers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{actuator}}/circuitbreakers"
          }
        },
        {
          "name": "Eventos del Circuit Breaker de payment-service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{actuator}}/circuitbreakerevents/payment-service"
          }
        },
        {
          "name": "Eventos de Retry de event-service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{actuator}}/retryevents/event-service"
          }
        },
        {
          "name": "Health (incluye el estado de los circuitos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{actuator}}/health"
          }
        }
      ]
    }
  ]
}