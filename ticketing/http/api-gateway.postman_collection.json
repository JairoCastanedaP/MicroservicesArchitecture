{
  "info": {
    "name": "Ticketing - api-gateway (Sesión 4)",
    "description": "Peticiones de prueba para api-gateway. TODO entra por el puerto 8080: el gateway envía cada petición al servicio que le corresponde según su ruta. Requiere los cinco servicios en marcha. Los login guardan cada token en una variable de la colección. Cada petición incluye pruebas del código HTTP esperado (pestaña Scripts > Post-response).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "actuator",
      "value": "http://localhost:8080/actuator",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "anaToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticación (ejecutar primero)",
      "item": [
        {
          "name": "Login CUSTOMER Ana (ana@mail.com) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('anaToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@mail.com\",\n  \"password\": \"Customer123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login ORGANIZER (organizer@ticketing.pe) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('organizerToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@ticketing.pe\",\n  \"password\": \"Organizer123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login ADMIN (admin@ticketing.pe) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ticketing.pe\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Catálogo (event-service)",
      "item": [
        {
          "name": "Cartelera pública, sin token -> 200 (header X-Gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.headers.get('X-Gateway')).to.eql('ticketing-api-gateway'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events?status=PUBLISHED",
            "auth": {
              "type": "noauth"
            },
            "header": []
          }
        },
        {
          "name": "Crear recinto sin token -> 401 (lo corta el gateway)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/venues",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arena Gateway\",\n  \"city\": \"Lima\",\n  \"address\": \"Av. Javier Prado 100\",\n  \"capacity\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear recinto como CUSTOMER -> 403 (lo corta event-service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/venues",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arena Gateway\",\n  \"city\": \"Lima\",\n  \"address\": \"Av. Javier Prado 100\",\n  \"capacity\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear recinto como ORGANIZER -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/venues",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{organizerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arena Gateway\",\n  \"city\": \"Lima\",\n  \"address\": \"Av. Javier Prado 100\",\n  \"capacity\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Compra (booking-service → event-service y payment-service)",
      "item": [
        {
          "name": "Reservar como Ana -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('bookingId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"ticketCategoryId\": 2,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Pagar -> 200 CONFIRMED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('CONFIRMED'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/bookings/{{bookingId}}/pay",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Mis reservas -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Pagos de la reserva (ADMIN, payment-service) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json()).to.have.lengthOf(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/payments?bookingId={{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        }
      ]
    },
    {
      "name": "Usuarios (user-service)",
      "item": [
        {
          "name": "Mi perfil -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/users/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Rutas configuradas en el gateway (Actuator) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json()).to.have.lengthOf(4); });",
                  "pm.test('Validación 2', () => { pm.response.json().forEach(r => pm.expect(r.uri).to.match(/^http:/)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{actuator}}/gateway/routes",
            "auth": {
              "type": "noauth"
            },
            "header": []
          }
        }
      ]
    }
  ]
}