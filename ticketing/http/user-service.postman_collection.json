{
  "info": {
    "name": "Ticketing - user-service (Sesión 4)",
    "description": "Peticiones de prueba para user-service. Registro, login y tokens JWT. Ejecuta las peticiones en orden sobre una base recién creada (usuarios semilla: admin@ticketing.pe, organizer@ticketing.pe, ana@mail.com y luis@mail.com). Los login guardan cada token en una variable de la colección. Cada petición incluye pruebas del código HTTP esperado (pestaña Scripts > Post-response).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8084/api/v1",
      "type": "string"
    },
    {
      "key": "auth",
      "value": "http://localhost:8084/api/v1",
      "type": "string"
    },
    {
      "key": "root",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "anaToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "mariaId",
      "value": "5",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Registro",
      "item": [
        {
          "name": "Registrarse -> 201 (todo usuario nuevo es CUSTOMER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().role).to.eql('CUSTOMER'); });",
                  "pm.test('Validación 2', () => { pm.expect(pm.response.json()).to.not.have.property('passwordHash'); });",
                  "pm.collectionVariables.set('mariaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@mail.com\",\n  \"password\": \"Secreta123\",\n  \"fullName\": \"María Quispe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registrarse con un correo ya usado -> 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@mail.com\",\n  \"password\": \"OtraClave123\",\n  \"fullName\": \"Ana\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Registro inválido -> 400 con lista de errores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().errors).to.have.lengthOf(3); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-es-un-correo\",\n  \"password\": \"123\",\n  \"fullName\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "Login CUSTOMER Ana (ana@mail.com) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('anaToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@mail.com\",\n  \"password\": \"Customer123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login ADMIN (admin@ticketing.pe) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{auth}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ticketing.pe\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login con contraseña incorrecta -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().detail).to.eql('Correo o contraseña incorrectos'); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@mail.com\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clave pública para validar los tokens (JWKS, público) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().keys[0].kty).to.eql('RSA'); });",
                  "pm.test('Validación 2', () => { pm.expect(pm.response.json().keys[0]).to.not.have.property('d'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{root}}/.well-known/jwks.json",
            "auth": {
              "type": "noauth"
            },
            "header": []
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Mi perfil sin token -> 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/users/me",
            "auth": {
              "type": "noauth"
            },
            "header": []
          }
        },
        {
          "name": "Mi perfil (con el token de Ana) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().email).to.eql('ana@mail.com'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/users/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Listar usuarios como CUSTOMER -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Listar usuarios como ADMIN -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": []
          }
        },
        {
          "name": "Convertir a María en ORGANIZER (ADMIN) -> 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().role).to.eql('ORGANIZER'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{host}}/users/{{mariaId}}/role",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ORGANIZER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cambiar un rol como CUSTOMER -> 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{host}}/users/{{mariaId}}/role",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
