              "raw": "{\n  \"name\": \"Noche de Stand Up\",\n  \"description\": \"Comediantes nacionales\",\n  \"category\": \"COMEDY\",\n  \"venueId\": 2,\n  \"dateTime\": \"2027-03-01T21:00:00\",\n  \"ticketCategories\": [\n    {\n      \"name\": \"Preferencial\",\n      \"price\": 120.0,\n      \"capacity\": 300\n    },\n    {\n      \"name\": \"General\",\n      \"price\": 80.0,\n      \"capacity\": 700\n    }\n  ]\n}",
