{
  "info": {
    "name": "Ticketing - event-service (Sesión 3)",
    "description": "Peticiones de prueba para event-service. Ejecuta las peticiones en orden sobre una base de datos recién creada (con los datos semilla). Cada petición incluye pruebas del código HTTP esperado (pestaña Scripts > Post-response).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8081/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Recintos",
      "item": [
        {
          "name": "Listar recintos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/venues"
          }
        },
        {
          "name": "Obtener recinto por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().id).to.eql(1); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/venues/1"
          }
        },
        {
          "name": "Crear recinto -> 201 + Location",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.headers.has('Location')).to.be.true; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/venues",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teatro Peruano Japonés\",\n  \"city\": \"Lima\",\n  \"address\": \"Av. Gregorio Escobedo 803, Jesús María\",\n  \"capacity\": 1200\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear recinto inválido -> 400 con lista de errores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().errors).to.have.lengthOf(2); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/venues",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"city\": \"Lima\",\n  \"capacity\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar todos los eventos (con recinto y zonas en UNA consulta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events"
          }
        },
        {
          "name": "Filtrar por ciudad (sin distinguir mayúsculas), categoría y estado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json()).to.have.lengthOf(2); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events?city=lima&status=PUBLISHED"
          }
        },
        {
          "name": "Obtener evento por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().venue.name).to.eql('Estadio Nacional'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events/1"
          }
        },
        {
          "name": "Evento inexistente -> 404 (ProblemDetail)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().title).to.eql('Recurso no encontrado'); });",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events/999"
          }
        },
        {
          "name": "Zonas (ticket categories) de un evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events/1/ticket-categories"
          }
        },
        {
          "name": "S3: Disponibilidad y precio de una zona (lo consulta booking-service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().onSale).to.be.true; });",
                  "pm.test('Validación 2', () => { pm.expect(pm.response.json().price).to.eql(450); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events/1/ticket-categories/1/availability"
          }
        },
        {
          "name": "S3: Disponibilidad de una zona que no es del evento -> 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Formato ProblemDetail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host}}/events/1/ticket-categories/4/availability"
          }
        },
        {
          "name": "Crear evento -> 201 + Location (nace en DRAFT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('Validación 1', () => { pm.expect(pm.response.json().status).to.eql('DRAFT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{host}}/events",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
